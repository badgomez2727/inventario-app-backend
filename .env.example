# Copia este archivo a .env y completa los valores reales. Nunca commitees
# el .env real (ya está en .gitignore) — este archivo es solo la plantilla.

# Cadena de conexión de PostgreSQL (Neon en producción/staging, local para desarrollo).
DATABASE_URL=

# Clave secreta para firmar los tokens JWT.
JWT_SECRET=

# API key de tu cuenta de Resend (https://resend.com), usada para enviar
# correos transaccionales (hoy, solo el de recuperación de contraseña).
RESEND_API_KEY=

# Remitente de los correos, formato "Nombre <correo@dominio>". El dominio debe
# estar verificado en Resend (SPF/DKIM/DMARC). Si se deja vacío, el código usa
# 'Vendita <no-reply@mail.tyndallcore.com>' por defecto.
EMAIL_FROM=

# API key de Anthropic, usada por el borrador de pedidos por WhatsApp con IA (plan PRO).
ANTHROPIC_API_KEY=

# 'true' hace que el borrador de pedidos por WhatsApp use una respuesta simulada
# en vez de llamar a la API de Anthropic — úsalo en staging/pruebas para no gastar tokens reales.
AI_ORDER_MOCK=false

# URL del frontend correspondiente a este entorno (se usa para armar el enlace
# del correo de recuperación de contraseña, entre otros).
FRONTEND_URL=http://localhost:3000
