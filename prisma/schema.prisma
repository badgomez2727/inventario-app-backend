    // venta_inventario_app/backend/prisma/schema.prisma

    generator client {
      provider = "prisma-client-js"
    }

    datasource db {
      provider = "postgresql"
      url      = env("DATABASE_URL")
    }

    // Modelo para las Compañías
    model Company {
      id                  Int           @id @default(autoincrement())
      nombre              String        @unique @db.VarChar(255)
      direccion           String?       @db.VarChar(255)
      telefono            String?       @db.VarChar(50)
      emailContacto       String        @unique @db.VarChar(255)
      activo              Boolean       @default(true)
      // Marca la compañía interna de Tyndall (super_admin_sistema real +
      // cuenta demo) — nunca una compañía de cliente. La usan los scripts de
      // limpieza para saber qué NUNCA hay que borrar, sin depender de
      // mantener su id a mano. Ver scripts/crear-compania-interna.js.
      esInterna           Boolean       @default(false) @map("es_interna")
      // Plan de la compañía: define los límites de uso (ver backend/src/config/plans.js).
      // "FREE" = plan gratis con techo de uso; "BASICO"/"PRO" = planes pagos.
      plan                String        @default("FREE") @db.VarChar(20)
      // Fecha en que vence el plan pago actual (null = no vence, ej. FREE).
      // Si ya pasó, el sistema trata a la compañía como FREE aunque `plan`
      // todavía diga "BASICO"/"PRO" — ver getEffectivePlanName() en plans.js.
      planExpiresAt       DateTime?     @map("plan_expires_at") @db.Timestamp(0)
      fechaCreacion       DateTime      @map("fecha_creacion") @default(now()) @db.Timestamp(0)
      fechaActualizacion  DateTime      @map("fecha_actualizacion") @updatedAt @db.Timestamp(0)

      users               User[]
      products            Product[]
      clients             Client[]
      suppliers           Supplier[]
      stockMovements      StockMovement[]
      sales               Sale[]
      productChangeLogs   ProductChangeLog[]
      payments            Payment[]

      @@map("companies")
    }

    // Modelo para los Usuarios
    model User {
      id                  Int             @id @default(autoincrement())
      companyId           Int             @map("company_id")
      nombreUsuario       String          @unique @db.VarChar(100)
      email               String          @unique @db.VarChar(255)
      password            String          @db.VarChar(255)
      rol                 String          @db.VarChar(50) @default("empleado_inventario")
      activo              Boolean         @default(true)
      fechaCreacion       DateTime        @map("fecha_creacion") @default(now()) @db.Timestamp(0)
      fechaActualizacion  DateTime        @map("fecha_actualizacion") @updatedAt @db.Timestamp(0)

      company             Company         @relation(fields: [companyId], references: [id])
      stockMovements      StockMovement[]
      sales               Sale[]
      passwordResetTokens PasswordResetToken[]
      productChangeLogs   ProductChangeLog[]
      payments            Payment[]

      @@map("users")
      @@unique([email, companyId])
      @@unique([nombreUsuario, companyId])
    }

    // Modelo Producto (¡Ahora con relación a Supplier!)
    model Product {
      id                  Int             @id @default(autoincrement())
      companyId           Int             @map("company_id")
      nombre              String          @db.VarChar(255)
      descripcion         String?         @db.Text
      sku                 String          @db.VarChar(100)
      precioCompra        Decimal         @map("precio_compra") @db.Decimal(10, 2)
      precioVenta         Decimal         @map("precio_venta") @db.Decimal(10, 2)
      stockActual         Int             @map("stock_actual") @default(0)
      unidadMedida        String          @map("unidad_medida") @db.VarChar(50) @default("unidad")
      categoria           String?         @db.VarChar(100)
      imagenUrl           String?         @map("imagen_url") @db.VarChar(255)
      activo              Boolean         @default(true)
      fechaCreacion       DateTime        @map("fecha_creacion") @default(now()) @db.Timestamp(0)
      fechaActualizacion  DateTime        @map("fecha_actualizacion") @updatedAt @db.Timestamp(0)
      supplierId          Int?            @map("supplier_id")

      stockMovements      StockMovement[]
      saleItems           SaleItem[]
      changeLogs          ProductChangeLog[]

      company             Company         @relation(fields: [companyId], references: [id])
      supplier            Supplier?       @relation(fields: [supplierId], references: [id])

      @@map("productos")
      @@index([companyId])
      @@unique([companyId, sku])
      @@index([supplierId])
    }

    // Historial de cambios de un producto (precios, stock manual, etc.).
    // Cada vez que updateProduct cambia un campo "sensible" queda un registro
    // aquí con el valor anterior y el nuevo, quién lo hizo y cuándo.
    model ProductChangeLog {
      id                  Int             @id @default(autoincrement())
      productId           Int             @map("product_id")
      companyId           Int             @map("company_id")
      userId              Int             @map("user_id")
      campo               String          @db.VarChar(50)
      valorAnterior       String?         @map("valor_anterior") @db.Text
      valorNuevo          String?         @map("valor_nuevo") @db.Text
      fecha               DateTime        @default(now()) @db.Timestamp(0)

      product             Product         @relation(fields: [productId], references: [id])
      company             Company         @relation(fields: [companyId], references: [id])
      user                User            @relation(fields: [userId], references: [id])

      @@map("product_change_log")
      @@index([productId])
      @@index([companyId])
      @@index([userId])
    }

    model StockMovement {
      id                  Int             @id @default(autoincrement())
      productId           Int             @map("product_id")
      companyId           Int             @map("company_id")
      userId              Int             @map("user_id")
      tipo                String          @db.VarChar(50)
      cantidad            Int
      motivo              String?         @db.VarChar(255)
      fechaMovimiento     DateTime        @map("fecha_movimiento") @default(now()) @db.Timestamp(0)

      product             Product         @relation(fields: [productId], references: [id])
      company             Company         @relation(fields: [companyId], references: [id])
      user                User            @relation(fields: [userId], references: [id])

      @@map("stock_movements")
      @@index([productId])
      @@index([companyId])
      @@index([userId])
    }


    model Sale {
      id                  Int             @id @default(autoincrement())
      companyId           Int             @map("company_id")
      userId              Int             @map("user_id")
      clientId            Int?            @map("client_id") 
      fechaVenta          DateTime        @map("fecha_venta") @default(now()) @db.Timestamp(0)
      total               Decimal         @db.Decimal(10, 2)
      estado              String          @db.VarChar(50)
      estadoPago          String          @default("PAGADA") 

      company             Company         @relation(fields: [companyId], references: [id])
      user                User            @relation(fields: [userId], references: [id])
      client              Client?         @relation(fields: [clientId], references: [id]) // <-- Relación añadida
      saleItems           SaleItem[]
      payments            Payment[]

      @@map("sales")
      @@index([companyId])
      @@index([userId])
      @@index([clientId]) 
    }

    model SaleItem {
      id                  Int             @id @default(autoincrement())
      saleId              Int             @map("sale_id")
      productId           Int             @map("product_id")
      cantidad            Int
      precioUnitario      Decimal         @db.Decimal(10, 2)
      subtotal            Decimal         @db.Decimal(10, 2)

      sale                Sale            @relation(fields: [saleId], references: [id])
      product             Product         @relation(fields: [productId], references: [id])

      @@map("sale_items")
      @@index([saleId])
      @@index([productId])
    }

    model Client {
      id                  Int             @id @default(autoincrement())
      nombre              String
      email               String?
      telefono            String?
      direccion           String?
      companyId           Int
      company             Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
      sales               Sale[]          // Relación inversa para ver las ventas de un cliente
      createdAt           DateTime        @default(now())
      updatedAt           DateTime        @updatedAt

      @@map("clients") // Asegúrate de que esta tabla se mapee correctamente
      @@unique([nombre, companyId]) // Un cliente con el mismo nombre y compañía debe ser único
    }

    model Supplier {
      id                  Int             @id @default(autoincrement())
      nombre              String
      contacto            String?
      telefono            String?
      direccion           String?
      companyId           Int
      company             Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
      products            Product[]
      createdAt           DateTime        @default(now())
      updatedAt           DateTime        @updatedAt

      @@map("suppliers") // Asegúrate de que esta tabla se mapee correctamente
      @@unique([nombre, companyId]) // Un proveedor con el mismo nombre y compañía debe ser único
    }
    


model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@map("password_reset_tokens")
  @@index([userId])
}

// Abonos/pagos de una venta. Una venta puede tener varios pagos parciales;
// el estadoPago de la venta (PENDIENTE/PARCIAL/PAGADA) se recalcula a partir
// de la suma de los pagos NO anulados cada vez que se registra o anula uno.
// Un pago nunca se borra: anularlo solo marca `anulado = true` con su motivo,
// para conservar el rastro de auditoría.
model Payment {
  id                Int      @id @default(autoincrement())
  saleId            Int      @map("sale_id")
  companyId         Int      @map("company_id")
  monto             Decimal  @db.Decimal(10, 2)
  fecha             DateTime @default(now()) @db.Timestamp(0)
  metodo            String   @db.VarChar(50)
  userId            Int      @map("user_id")
  nota              String?  @db.Text
  anulado           Boolean  @default(false)
  motivoAnulacion   String?  @map("motivo_anulacion") @db.Text

  sale              Sale     @relation(fields: [saleId], references: [id])
  company           Company  @relation(fields: [companyId], references: [id])
  user              User     @relation(fields: [userId], references: [id])

  @@map("payments")
  @@index([saleId])
  @@index([companyId])
  @@index([userId])
}

